# CDN Splitwise Configuration
# Port binding: use 127.0.0.1 behind a reverse proxy (Caddy/Nginx) or Tailscale;
# set 0.0.0.0 only if the port must be reachable from other hosts directly.
CDN_SPLIT_BIND_IP=127.0.0.1
CDN_SPLIT_PORT=8095
SYNC_INTERVAL_SECONDS=300
PING_INTERVAL_SECONDS=180

# Security & Homelab Configuration
# APP_ENV=production refuses to start with an insecure APP_SECRET_KEY.
APP_ENV=production
# Required: generate with `openssl rand -hex 32` (min length 24 chars).
# Keep it out of backups you share: without it, encrypted tokens cannot be decrypted.
APP_SECRET_KEY=change-this-to-a-secure-random-secret
# Required in production: 4-8 digits, protects /api endpoints.
APP_ACCESS_PIN=
# Optional HTTP(S) proxy for api.telegram.org, e.g. http://127.0.0.1:8118
TELEGRAM_PROXY=
